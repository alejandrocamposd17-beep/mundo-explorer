# Copia este archivo como .env.local y ajusta los valores si lo necesitas.
# Ninguna de estas APIs requiere clave, pero las URLs se configuran por entorno.

# Nombre público de la app (visible en el navegador)
NEXT_PUBLIC_APP_NAME=Mundo Explorer

# Dataset de países (solo servidor) — fuente original de REST Countries
COUNTRIES_API_URL=https://raw.githubusercontent.com/mledoze/countries/master/dist/countries.json

# API de clima (solo servidor, usada por el Route Handler /api/clima)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# API de geocodificación (solo servidor) para ubicar la capital de cada país
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# API de calidad del aire (solo servidor)
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# URL pública del sitio (para Open Graph y enlaces absolutos)
NEXT_PUBLIC_SITE_URL=https://mundo-explorer.vercel.app

# Supabase (opcional): inicio de sesión y favoritos en la nube.
# Sin estas variables la app funciona igual y guarda los favoritos en el navegador.
# La "anon key" es pública por diseño: la seguridad la dan las políticas RLS de supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
